{
  "appId": "com.lumenpro.app",
  "appName": "LUMEN PRO",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#08080A"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#08080A",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#08080A",
      "overlaysWebView": false
    }
  }
}
